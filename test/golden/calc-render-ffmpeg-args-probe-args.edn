{:audio
 ["/bin/ffprobe"
  "-v"
  "error"
  "-select_streams"
  "a:0"
  "-show_entries"
  "stream=channels,bit_rate"
  "-of"
  "csv=p=0"
  "in"],
 :video
 ["ffprobe"
  "-v"
  "error"
  "-select_streams"
  "v:0"
  "-show_entries"
  "stream=width,height,r_frame_rate,bit_rate"
  "-of"
  "csv=p=0"
  "in"]}
