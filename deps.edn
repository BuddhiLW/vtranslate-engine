{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}

        ;; ADTs (defadt/adt-case) + Result monad (ok/err/bind/let-ok/try-effect).
        io.github.hive-agi/hive-dsl    {:mvn/version "0.5.10"}

        ;; re-frame-style event/effect pipeline: pure handlers return effects
        ;; AS DATA; IO happens only in reg-fx interpreters (the CPPB boundary).
        io.github.hive-agi/hive-events {:mvn/version "0.5.6"}

        ;; DIP filesystem/path effects (IFilesystem / IPathQuery).
        ;; 0.3.1 is the first release implementing IFilesystem (mkdirs!/tmpdir!/
        ;; atomic-write!) — the transcript cache writes through it.
        io.github.hive-agi/hive-system {:mvn/version "0.3.2"}

        ;; Bounded concurrency primitives (bounded-pmap, safe-future, gate). The
        ;; Collect layer fans out over media sources under a hard concurrency
        ;; bound — each ffmpeg grabber is stateful + holds native memory, so the
        ;; bound is what protects file handles / off-heap allocation. (Already a
        ;; transitive dep of hive-system; pinned explicitly because we use it.)
        io.github.hive-agi/hive-weave  {:mvn/version "0.3.1"}

        ;; Config DI — typed EDN/env config resolution (provider routing). The
        ;; engine reads ~/.config/vtranslate/config.edn ITSELF (standalone, like
        ;; hive-mcp's env_config), so providers swap by config with no code edit.
        ;; We require hive-di.source + hive-di.resolve DIRECTLY (never hive-di.core)
        ;; so defconfig's Malli schema generation never drags Malli onto the engine
        ;; classpath. Local working copy; re-pin to a git/sha once hive-di tags a
        ;; release. Pinned to the v0.3.1 release here; the live working copy is
        ;; wired for engine-coupled dev via local.deps.edn (:local/root, gitignored)
        ;; so the LSP sidecar + CI resolve from git without host paths.
        io.github.hive-agi/hive-di     {:mvn/version "0.4.1"}

        ;; JSON for the LLM translator adapters (OpenAI-compatible chat APIs —
        ;; OpenRouter / Venice / OpenAI / ...). java.net.http handles the transport
        ;; (JDK built-in, no dep); cheshire encodes the request + parses the reply.
        cheshire/cheshire {:mvn/version "6.2.0"}

        ;; Binary serialization for the transcript cache. ASR is the only stage
        ;; that costs minutes, so its output is persisted and re-used; fressian
        ;; round-trips Clojure data compactly without EDN's print/read cost.
        org.clojure/data.fressian {:mvn/version "1.1.0"}}

 :aliases
 {:dev  {:extra-paths ["dev"]
         :extra-deps {nrepl/nrepl       {:mvn/version "1.7.0"}
                      cider/cider-nrepl {:mvn/version "0.62.2"}}}


  ;; Malli value objects for the kernel VOs + cross-boundary maps.
  ;; NON-RUNTIME: kept OFF :paths [src] so the subprocess core stays malli-free.
  :schemas {:extra-paths ["schemas"]
            :extra-deps {metosin/malli               {:mvn/version "0.20.1"}
                         io.github.hive-agi/hive-spi  {:mvn/version "0.1.18"}}}

  ;; Optional Typed Clojure check over the schema-derived annotations.
  :typed {:extra-paths ["schemas"]
          :extra-deps {metosin/malli                      {:mvn/version "0.20.1"}
                       io.github.hive-agi/hive-spi         {:mvn/version "0.1.18"}
                       org.typedclojure/typed.clj.checker  {:mvn/version "1.4.0"}}}
  :test {:extra-paths ["test" "schemas"]
         :extra-deps {lambdaisland/kaocha     {:mvn/version "1.91.1392"}
                      org.clojure/test.check  {:mvn/version "1.1.1"}
                      ;; hive-test 0.3.12 ships golden/mutation/trifecta (also hive-schemas.test dep).
                      io.github.hive-agi/hive-test    {:mvn/version "0.3.12"}
                      metosin/malli                   {:mvn/version "0.20.1"}
                      io.github.hive-agi/hive-spi     {:mvn/version "0.1.18"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.1.11"}}
         :main-opts ["-m" "kaocha.runner"]}

  ;; M5 — ffmpeg via bytedeco JavaCV (in-process, no system ffmpeg). Only the
  ;; engine.collect.* layer touches this. SLIM build: javacv wrappers + the
  ;; linux-x86_64 ffmpeg/javacpp NATIVES only — NOT javacv-platform, which drags
  ;; opencv/leptonica/openblas natives for every OS (multi-GB). For other
  ;; platforms swap the :classifier (macosx-arm64, windows-x86_64, ...) or use
  ;; org.bytedeco/ffmpeg-platform. javacv<->ffmpeg pairing CONFIRMED on linux:
  ;; javacv 1.5.14 ⟷ ffmpeg 8.1.2-1.5.14, kept on the same JavaCPP line as ONNX.
  :ffmpeg {:extra-deps {org.bytedeco/javacv                {:mvn/version "1.5.14"}
                        org.bytedeco/ffmpeg$linux-x86_64   {:mvn/version "8.1.2-1.5.14"}
                        org.bytedeco/javacpp$linux-x86_64  {:mvn/version "1.5.14"}}}

  ;; --- Optional ASR (ITranscriber) native backends ------------------------
  ;; The engine core loads WITHOUT any of these; each adapter lazy-probes its
  ;; backend and resolves to :error/transcriber-unavailable when absent. Activate
  ;; a backend by adding its alias. The :openai-whisper / :groq / :whisper-server
  ;; providers need NO alias (java.net.http + cheshire are already on the core cp).

  ;; Path 1 — whisper.cpp via JNI. CPU natives ship in the jar; for the RTX 4070
  ;; build libwhisper.so with -DGGML_CUDA=1 and point
  ;; -Dio.github.givimad.whisperjni.libdir=<dir> at it.
  :whisper-jni {:extra-deps {io.github.givimad/whisper-jni {:mvn/version "1.7.1"}}}

  ;; Path 2 — sherpa-onnx (k2-fsa): Whisper + many ASR models over ONNX Runtime.
  :sherpa {:extra-deps {com.k2fsa.sherpa.onnx/sherpa-onnx {:mvn/version "1.10.30"}}}

  ;; Path 3 — ONNX Runtime via bytedeco (same native-loading machinery as JavaCV).
  :onnx {:extra-paths ["test-onnx"]
         :extra-deps {org.bytedeco/onnxruntime {:mvn/version "1.28.0-1.5.14"}
                       org.bytedeco/onnxruntime$linux-x86_64 {:mvn/version "1.28.0-1.5.14"}
                       org.bytedeco/javacpp$linux-x86_64 {:mvn/version "1.5.14"}
                       org.bytedeco/opencl$linux-x86_64 {:mvn/version "3.1-1.5.14"}
                       org.bytedeco/dnnl$linux-x86_64 {:mvn/version "3.13-1.5.14"}
                       org.bytedeco/openvino$linux-x86_64 {:mvn/version "2026.2.1-1.5.14"}
                       com.github.wendykierp/JTransforms {:mvn/version "3.1"}}}

  ;; VAD — Silero VAD Java/ONNX Runtime adapter. Activate with
  ;; VTRANSLATE_ENGINE_ALIASES=":ffmpeg:whisper-jni:silero-vad:run" and
  ;; VT_SEGMENTER=silero-vad (plus models/silero_vad.onnx).
  :silero-vad {:extra-deps {com.microsoft.onnxruntime/onnxruntime {:mvn/version "1.23.1"}}}

  ;; Path 4 — Panama FFM binds libwhisper.so directly; no dependency, JDK 22+
  ;; foreign API. Point -Dvtranslate.whisper.lib=<libwhisper.so> at your build.

  ;; Path 5 — JVM-native HF ASR on the raster compiler (pretrained-rstr; no
  ;; Python, no ONNX runtime). Qwen3-ASR multilingual (52 languages, per-call
  ;; :language hint => per-span language routing). Weights auto-download
  ;; sha-pinned from HF into ~/.cache/raster/models on first load; config
  ;; [:transcriber-opts :model-dir] points at a local dir to skip. JDK 21+.
  :qwen3-asr {:extra-deps {org.replikativ/pretrained-rstr {:mvn/version "0.1.6"}}}

  ;; Path 6 — NVIDIA NeMo (Canary / Parakeet) through an EMBEDDED CPython.
  ;; Canary is the only ASR backend here that also TRANSLATES (AST), so it is
  ;; the one provider a :target-language reaches. pretrained-rstr cannot serve
  ;; these: its registry is moonshine + qwen3-asr, and NeMo ships .nemo
  ;; checkpoints rather than the safetensors it loads. Needs a Python <= 3.12
  ;; with nemo_toolkit[asr] installed; point [:transcriber-opts
  ;; :python-executable] at it (default: ~/anaconda3/envs/vtranslate-asr/bin/python).
  :nemo {:extra-deps {clj-python/libpython-clj {:mvn/version "2.026"}}}

  ;; Subprocess entrypoint the CLI shells out to.
  :run  {:main-opts ["-m" "vtranslate.engine.main"]}

  ;; hive-recife JobState FSM model-check (TLA+/TLC). NON-RUNTIME: hive-recife
  ;; pulls malli transitively, so it is kept OFF :paths ["src"] — the
  ;; subprocess cores stay malli-free. Model specs live under model/ and are
  ;; never required from src. Local working copy wired via local.deps.edn.
  :model {:extra-paths ["model"]
          :extra-deps {io.github.hive-agi/hive-recife
                       {:git/sha "2734b324642afac34fed6803495819343481121f"}}}
  :test-repl {:extra-paths ["test" "schemas"]
 :extra-deps {nrepl/nrepl                      {:mvn/version "1.7.0"}
              cider/cider-nrepl                {:mvn/version "0.62.2"}
              lambdaisland/kaocha              {:mvn/version "1.91.1392"}
              org.clojure/test.check           {:mvn/version "1.1.1"}
              io.github.hive-agi/hive-test     {:mvn/version "0.3.12"}
              metosin/malli                    {:mvn/version "0.20.1"}
              io.github.hive-agi/hive-spi       {:mvn/version "0.1.18"}
              io.github.hive-agi/hive-schemas  {:mvn/version "0.1.11"}}
 :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                 slipset/deps-deploy           {:mvn/version "0.2.5"}}
          :ns-default build}}}
